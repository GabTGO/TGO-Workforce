ENVIRONMENT=development

# Local Postgres for development. In Railway, set this to reference the
# Postgres plugin instead: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tgo_workforce

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

SECRET_KEY=change-me

# Filled in once Zoho SSO is set up.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
