ENVIRONMENT=development

# Local Postgres for development. In Railway, set this to reference the
# Postgres plugin instead: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tgo_workforce

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

SECRET_KEY=change-me

# Where the Zoho login flow (and logout) sends the browser back to.
FRONTEND_URL=http://localhost:3000

# --- TGO Gateway single sign-on --------------------------------------------
# Set GATEWAY_URL and the TGO Gateway owns sign-in: every request forwards the
# shared Gateway cookie to ${GATEWAY_URL}/api/auth/verify with
# {toolId: GATEWAY_TOOL_ID}, and the Zoho login below is switched off. Leave it
# empty locally to keep using the Zoho login. In production both this backend
# and the frontend must be served from *.tgocorp.com, or the browser never
# sends the Gateway cookie. See app/core/gateway.py.
GATEWAY_URL=
# Must equal the tool id registered in the Gateway (TGO-Gateway-Portal).
GATEWAY_TOOL_ID=workforce
# GATEWAY_SESSION_COOKIE=tgo_gateway_session   # shared cookie name (default)

# From https://api-console.zoho.com — a "Server-based Application" client.
# ZOHO_REDIRECT_URI must be this backend's own /auth/zoho/callback URL and
# must match, character for character, what's registered in the API Console.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/auth/zoho/callback

# Comma-separated emails that are always promoted to "admin" on Zoho
# sign-in — the one way to bootstrap the first admin without touching the
# database. Everyone else starts as "viewer" and is promoted from the User
# Management page by an existing admin.
ZOHO_ADMIN_EMAILS=

# --- Zoho Mail (attendance violation notices) -------------------------------
# A SEPARATE Zoho API registration/scope from ZOHO_CLIENT_ID/SECRET above —
# those are for "Sign in with Zoho"; these are for actually sending mail
# through the Zoho Mail API on behalf of the attendance notice mailbox.
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_MAIL_FROM_ADDRESS=attendance@tgocorp.com
ZOHO_MAIL_API_BASE_URL=https://mail.zoho.com/api
# Comma-separated list of other addresses validated as "send as" aliases on
# the connected Zoho Mail account, if any exist beyond ZOHO_MAIL_FROM_ADDRESS.
ZOHO_MAIL_KNOWN_ALIASES=

# How often (seconds) the standalone send worker
# (app/workers/violation_email_worker.py) polls for Approved/Resend Approved
# violation records to send. Runs as its own process/service, separate from
# the API.
VIOLATION_SEND_WORKER_POLL_SECONDS=120

# --- Zoho Cliq (onboarding "Notify" button) ---------------------------------
# A Cliq Incoming Webhook — see backend/CLIQ_SETUP.md-equivalent instructions
# from the standalone onboarding app: generate the token from your own Cliq
# account's Settings > Bots & Tools > Webhook Tokens (not the channel's
# Connectors tab, which is a different, unrelated Cliq feature).
CLIQ_WEBHOOK_ENDPOINT=
CLIQ_WEBHOOK_TOKEN=

# --- Onboarding/Offboarding portal (New Hires) ------------------------------
# A separate, already-deployed system whose GET-only /api/external/new-hires
# API backs this app's New Hires page. Auth is a plain `x-api-key` header.
ONBOARDING_PORTAL_BASE_URL=
ONBOARDING_PORTAL_API_KEY=
