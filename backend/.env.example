ENVIRONMENT=development

# Local Postgres for development. In Railway, set this to reference the
# Postgres plugin instead: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tgo_workforce

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

SECRET_KEY=change-me

# Where the Zoho login flow (and logout) sends the browser back to.
FRONTEND_URL=http://localhost:3000

# From https://api-console.zoho.com — a "Server-based Application" client.
# ZOHO_REDIRECT_URI must be this backend's own /auth/zoho/callback URL and
# must match, character for character, what's registered in the API Console.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/auth/zoho/callback
